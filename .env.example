# Copy this file to .env and fill in real values. .env is gitignored — it
# will never be committed, so this is where personal/secret values belong
# (NOT hardcoded in settings.py).

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_CONTACT_EMAIL=rahamovshohzod@gmail.com

# Contact form → Telegram (optional). Leave empty and messages are still
# saved in the admin panel ("Xabarlar"), just not pushed to Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CONTACT_RATE_LIMIT_PER_HOUR=5

# Production only (DJANGO_DEBUG=False):
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=3600

# PostgreSQL (leave unset to use SQLite):
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=
# POSTGRES_PORT=5432
