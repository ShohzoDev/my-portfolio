# Copy this file to .env and fill in real values. .env is gitignored — it
# will never be committed, so this is where personal/secret values belong
# (NOT hardcoded in settings.py).

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_CONTACT_EMAIL=you@example.com

# True ONLY behind nginx / PythonAnywhere (they set X-Real-IP themselves).
# Without a proxy keep False, or anyone can fake their IP to dodge the
# admin login limit.
CONTACT_TRUST_PROXY_HEADERS=False

# Admin panel path (default "admin/"). Use something non-obvious in production.
# DJANGO_ADMIN_URL=manage-7f3k/

# Production only (DJANGO_DEBUG=False):
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=3600

# PostgreSQL (leave unset to use SQLite):
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=
# POSTGRES_PORT=5432
